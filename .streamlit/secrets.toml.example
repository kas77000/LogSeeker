# Optional. `.env` / real environment variables are the primary way to configure
# LogSeeker (see ../.env.example) and they OVERRIDE anything in this file.
#
# This file is only useful if you prefer TOML, or if you want to keep the
# non-secret settings here and the credentials in the environment.

backend = "ssh"
ssh_host = "loghost.example.internal"
ssh_port = 22
ssh_user = "youruser"

# Sign-in: pick one. If both are set the key wins and the password is a
# fallback, which is how you move from one to the other safely.
#
# Option A — password. The same one you type when you `ssh` in by hand.
# Nothing needs to be installed or changed on the log host.
ssh_password = "your-log-host-password"

# Option B — SSH key. Preferred once you can append a public key to
# ~/.ssh/authorized_keys on the log host. See README step 3B.
#ssh_key_path = "C:/Users/youruser/.ssh/logseeker_ed25519"
#ssh_key_passphrase = ""

# Leave blank to use your normal C:\Users\<you>\.ssh\known_hosts, which one
# `ssh youruser@loghost` populates. Nothing server-side, no admin rights.
ssh_known_hosts = ""
ssh_auto_add_host_key = false

log_dir_template  = "/apps/k/algologs/ap/{instance}/logs"
log_glob_template = "APA*_pingOrderStream_{date}*.out"
instances = ["APIA", "APIE"]

# There is no sign-in. This is the only access control the app provides.
allowed_networks = ["10.0.0.0/8", "192.168.0.0/16"]
show_admin = true

command_timeout = 900
workers = 3
max_files_per_search = 500
max_result_lines = 200000
max_result_bytes = 67108864
max_days_per_search = 14
cache_ttl_hours = 12
