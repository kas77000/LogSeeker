# Copy to .env (same folder as streamlit_app.py) and fill in.
# .env is gitignored. Real environment variables override anything set here.
#
# This file holds the SERVICE ACCOUNT's log-host login: the account that does
# what the legacy WinSCP chain did. Every search runs on the server as this
# account. Nobody signs in to the app.

# --- how LogSeeker reaches the log host --------------------------------------
# ssh   : app runs on your machine and connects to the log host  (normal case)
# local : app runs ON the log host itself, no hop needed
LOGSEEKER_BACKEND=ssh

LOGSEEKER_SSH_HOST=loghost.example.internal
LOGSEEKER_SSH_PORT=22
LOGSEEKER_SSH_USER=service-account-user

# --- how the app signs in: pick ONE of the two -------------------------------
#
# Both work. If BOTH are filled in, the key is used and the password is only a
# fallback — paramiko tries keys first — which is exactly how you migrate from
# one to the other without a flag day.
#
#   OPTION A — PASSWORD  (start here; needs nothing on the server)
#   OPTION B — SSH KEY   (better, once you can put a key on the log host)

# ..... OPTION A — password ...................................................
# Your normal log-host password, the same one you type when you `ssh` in by
# hand. Nothing has to be installed or changed on the server for this to work,
# so this is the option that needs no cooperation from anyone.
#
# It sits here in plain text on purpose: this file is the one place the login
# lives, so it is obvious where to change it and what to delete when the app is
# retired. Two things follow:
#   - .env is gitignored. Keep it that way; never commit it.
#   - Anyone who can read this file can log in as you. On a shared machine:
#       icacls .env /inheritance:r /grant:r "%USERNAME%:R"
#
# When your password rotates, change it here and restart. Until you do, every
# search fails with "Authentication failed".
LOGSEEKER_SSH_PASSWORD=service-account-password

# ..... OPTION B — SSH key ....................................................
# Preferred once you can append a public key to ~/.ssh/authorized_keys on the
# log host. Better than a password for three reasons: it survives password
# rotation, it can be revoked on its own without touching your login, and the
# server-side trail shows which connections came from the app.
#
# Installing it needs no admin rights on the host — authorized_keys is in your
# own home directory — but the server must permit key auth, which is why this
# is not the default here.
#
# Generate a key FOR THE APP, not your personal interactive one:
#   ssh-keygen -t ed25519 -f "$env:USERPROFILE\.ssh\logseeker_ed25519" -C logseeker
# then see README step 3B.
#
# Leave the passphrase empty: it would have to be stored right here next to the
# key for unattended start-up, which protects nothing. Use file permissions.
#LOGSEEKER_SSH_KEY_PATH=C:/Users/youruser/.ssh/logseeker_ed25519
#LOGSEEKER_SSH_KEY_PASSPHRASE=

# Host key verification. This is entirely on YOUR machine — it needs nothing
# from the server and no admin rights anywhere.
#
# Leave this blank and the app uses your normal C:\Users\<you>\.ssh\known_hosts,
# which one `ssh youruser@loghost` populates when you accept the fingerprint.
# That is the simplest route and the recommended one. Set an explicit path only
# if you keep a separate file for the app.
LOGSEEKER_SSH_KNOWN_HOSTS=
LOGSEEKER_SSH_AUTO_ADD_HOST_KEY=false

# --- where the logs are ------------------------------------------------------
LOGSEEKER_LOG_DIR_TEMPLATE=/apps/k/algologs/ap/{instance}/logs
LOGSEEKER_LOG_GLOB_TEMPLATE=APA*_pingOrderStream_{date}*.out
LOGSEEKER_INSTANCES=APIA,APIB,APIC,APID,APIE,APIF,APIG,APIH,APII,APIL,APIM

# --- kdb: does the id_target exist, and whose is it? -------------------------
# Each search first asks the OMS `target` table about the order id:
#   RDB  (today)          select trader from target where id_target=<id>
#   HDB  (earlier dates)  select date, trader from target
#                           where date in <dates>, id_target=<id>
# The answer is shown on the search card; it never blocks the log search.
# Leave both blank to switch the check off. Either one alone also works — the
# other half of the dates is then reported as "not checked".
# pykx connects over IPC only, so no q licence is needed on this machine.
LOGSEEKER_KDB_RDB=oms-rdb-host:5012
LOGSEEKER_KDB_HDB=oms-hdb-host:5010
# Only if the kdb processes require a login.
LOGSEEKER_KDB_USER=
LOGSEEKER_KDB_PASSWORD=
LOGSEEKER_KDB_TIMEOUT=30

# --- who can reach the app ---------------------------------------------------
# There is NO sign-in. Anyone who can open the URL searches as SSH_USER above,
# so this list is the only access control the app itself provides.
# Comma-separated CIDRs. Empty means anyone who can route to the port.
LOGSEEKER_ALLOWED_NETWORKS=10.0.0.0/8,192.168.0.0/16

# Set to false to hide the Admin page (connection test, audit log, config).
LOGSEEKER_SHOW_ADMIN=true

# --- guard rails -------------------------------------------------------------
# Every one of these caps announces itself in the UI when it is hit, so a
# truncated result is never shown as if it were complete.
LOGSEEKER_COMMAND_TIMEOUT=900        # seconds before a search is killed
LOGSEEKER_WORKERS=3                  # concurrent greps against the log host
LOGSEEKER_MAX_DAYS_PER_SEARCH=14
LOGSEEKER_CACHE_TTL_HOURS=12

# How much log a single search may read. With gigabyte-a-shard logs the file
# COUNT is a poor guard - 500 files can be half a terabyte - so this is the real
# ceiling. Checked after listing, before a single byte is read.
LOGSEEKER_MAX_SCAN_BYTES=214748364800   # 200 GB
LOGSEEKER_MAX_FILES_PER_SEARCH=500

# Bytes of log grepped per round trip. Each batch boundary is a progress update,
# so smaller values give finer progress at the cost of more SSH commands.
LOGSEEKER_SCAN_BATCH_BYTES=536870912    # 512 MB

# Caps on the RESULT (as opposed to the input above).
LOGSEEKER_MAX_RESULT_LINES=200000    # server-side, via `head -n`
LOGSEEKER_MAX_RESULT_BYTES=67108864  # 64 MB, enforced while streaming

# --- storage -----------------------------------------------------------------
#LOGSEEKER_DATA_DIR=./data
# Total budget for cached results. Oldest searches are evicted past this, so a
# busy week of large greps cannot quietly fill the disk.
LOGSEEKER_MAX_DISK_BYTES=5368709120  # 5 GB
# Results above this size get a two-step download with a gzip option instead of
# being pulled into memory on every rerun.
LOGSEEKER_INLINE_DOWNLOAD_BYTES=2097152  # 2 MB
