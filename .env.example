# Copy to .env (same folder as streamlit_app.py) and fill in.
# .env is gitignored. Real environment variables override anything set here.
#
# This file holds the OPERATOR's log-host login. Whoever launches the app is who
# every visitor's search runs as on the server. Nobody signs in to the app.

# --- how LogSeeker reaches the log host --------------------------------------
# ssh   : app runs on your machine and connects to the log host  (normal case)
# local : app runs ON the log host itself, no hop needed
LOGSEEKER_BACKEND=ssh

LOGSEEKER_SSH_HOST=loghost.example.internal
LOGSEEKER_SSH_PORT=22
LOGSEEKER_SSH_USER=youruser

# Key auth is strongly preferred. Generate a key for the app rather than
# reusing your interactive one, so it can be revoked on its own.
LOGSEEKER_SSH_KEY_PATH=C:/Users/youruser/.ssh/logseeker_id_ed25519
#LOGSEEKER_SSH_KEY_PASSPHRASE=
#LOGSEEKER_SSH_PASSWORD=

# Host key verification. Point at a known_hosts file containing the log host's
# key. Set AUTO_ADD_HOST_KEY=true for the first connection only, then capture
# the key and switch it back to false.
LOGSEEKER_SSH_KNOWN_HOSTS=C:/Users/youruser/.ssh/known_hosts
LOGSEEKER_SSH_AUTO_ADD_HOST_KEY=false

# --- where the logs are ------------------------------------------------------
LOGSEEKER_LOG_DIR_TEMPLATE=/apps/k/algologs/ap/{instance}/logs
LOGSEEKER_LOG_GLOB_TEMPLATE=APA*_pingOrderStream_{date}*.out
LOGSEEKER_INSTANCES=APIA,APIE

# --- who can reach the app ---------------------------------------------------
# There is NO sign-in. Anyone who can open the URL searches as SSH_USER above,
# so this list is the only access control the app itself provides.
# Comma-separated CIDRs. Empty means anyone who can route to the port.
LOGSEEKER_ALLOWED_NETWORKS=10.0.0.0/8,192.168.0.0/16

# Set to false to hide the Admin page (connection test, audit log, config).
LOGSEEKER_SHOW_ADMIN=true

# --- guard rails -------------------------------------------------------------
# Every one of these caps announces itself in the UI when it is hit, so a
# truncated result is never shown as if it were complete.
LOGSEEKER_COMMAND_TIMEOUT=900        # seconds before a search is killed
LOGSEEKER_WORKERS=3                  # concurrent greps against the log host
LOGSEEKER_MAX_DAYS_PER_SEARCH=14
LOGSEEKER_CACHE_TTL_HOURS=12

# How much log a single search may read. With gigabyte-a-shard logs the file
# COUNT is a poor guard - 500 files can be half a terabyte - so this is the real
# ceiling. Checked after listing, before a single byte is read.
LOGSEEKER_MAX_SCAN_BYTES=214748364800   # 200 GB
LOGSEEKER_MAX_FILES_PER_SEARCH=500

# Bytes of log grepped per round trip. Each batch boundary is a progress update,
# so smaller values give finer progress at the cost of more SSH commands.
LOGSEEKER_SCAN_BATCH_BYTES=536870912    # 512 MB

# Caps on the RESULT (as opposed to the input above).
LOGSEEKER_MAX_RESULT_LINES=200000    # server-side, via `head -n`
LOGSEEKER_MAX_RESULT_BYTES=67108864  # 64 MB, enforced while streaming

# --- storage -----------------------------------------------------------------
#LOGSEEKER_DATA_DIR=./data
# Total budget for cached results. Oldest searches are evicted past this, so a
# busy week of large greps cannot quietly fill the disk.
LOGSEEKER_MAX_DISK_BYTES=5368709120  # 5 GB
# Results above this size get a two-step download with a gzip option instead of
# being pulled into memory on every rerun.
LOGSEEKER_INLINE_DOWNLOAD_BYTES=2097152  # 2 MB
